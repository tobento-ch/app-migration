{
    "name": "tobento/app-migration",
    "version": "2.0",
    "type": "library",
    "description": "App migration support.",
    "keywords": [
        "tobento",
        "package",
        "PHP",
        "application",
        "migration"
    ],
    "homepage": "https://www.tobento.ch",
    "license": "MIT",
    "authors": [
        {
            "name": "Tobias Strub",
            "email": "info@tobento.ch",
            "homepage": "https://www.tobento.ch"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "psr/container": "^2.0",
        "tobento/app": "^2.0",
        "tobento/service-migration": "^2.0",
        "tobento/service-config": "^2.0",
        "tobento/service-dir": "^2.0"
    },
    "suggest": {
        "tobento/app-console": "Support for console commands",
        "tobento/service-responser": "Support for render migration messages"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.3",
        "vimeo/psalm": "^6.13",
        "tobento/app-console": "^2.0",
        "tobento/service-responser": "^2.0",
        "tobento/service-filesystem": "^2.0",
        "mockery/mockery": "^1.6",
        "nyholm/psr7": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "Tobento\\App\\Migration\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tobento\\App\\Migration\\Test\\": "tests",
            "Tobento\\Service\\Console\\Test\\": "vendor/tobento/service-console/tests"
        }
    },
    "scripts": {
        "test": "phpunit --testdox --colors=always",
        "psalm": "vendor/bin/psalm"
    }
}